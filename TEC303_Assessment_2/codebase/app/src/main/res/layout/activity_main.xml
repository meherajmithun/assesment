<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_background"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/FitnessTextEyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/screen_one_eyebrow"
                    android:textColor="@color/pool_cyan" />

                <Button
                    android:id="@+id/themeButton"
                    style="@style/FitnessButtonTheme"
                    android:layout_width="wrap_content"
                    android:text="@string/use_dark_mode" />
            </LinearLayout>

            <TextView
                style="@style/FitnessTextScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/screen_one_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:text="@string/screen_one_intro"
                android:textColor="@color/hero_text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/hero_progress_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/total_progress_label"
                        android:textColor="@color/hero_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/totalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/total_progress_initial"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/totalProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/progress_description"
                    android:max="150"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_track" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/FitnessTextEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:text="@string/workout_minutes_heading"
                android:textColor="@color/slate" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/badge_running"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_running"
                    android:tint="@color/coral" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FitnessTextFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/runningInput"
                        android:text="@string/running" />

                    <TextView
                        style="@style/FitnessTextTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/target_60" />
                </LinearLayout>

                <EditText
                    android:id="@+id/runningInput"
                    style="@style/WorkoutInput"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    tools:targetApi="o" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_background"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/badge_cycling"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_cycling"
                    android:tint="@color/success" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FitnessTextFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/cyclingInput"
                        android:text="@string/cycling" />

                    <TextView
                        style="@style/FitnessTextTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/target_30" />
                </LinearLayout>

                <EditText
                    android:id="@+id/cyclingInput"
                    style="@style/WorkoutInput"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    tools:targetApi="o" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_background"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/badge_swimming"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_swimming"
                    android:tint="@color/pool_cyan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FitnessTextFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/swimmingInput"
                        android:text="@string/swimming" />

                    <TextView
                        style="@style/FitnessTextTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/target_30" />
                </LinearLayout>

                <EditText
                    android:id="@+id/swimmingInput"
                    style="@style/WorkoutInput"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    tools:targetApi="o" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_background"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/badge_weightlifting"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_weightlifting"
                    android:tint="@color/warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FitnessTextFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/weightliftingInput"
                        android:text="@string/weightlifting" />

                    <TextView
                        style="@style/FitnessTextTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/target_10" />
                </LinearLayout>

                <EditText
                    android:id="@+id/weightliftingInput"
                    style="@style/WorkoutInput"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    tools:targetApi="o" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/resetButton"
                    style="@style/FitnessButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/track_blue"
                    android:text="@string/reset" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/reportButton"
                    style="@style/FitnessButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_weight="1.45"
                    android:drawableEnd="@drawable/ic_arrow_right"
                    android:drawablePadding="8dp"
                    android:text="@string/get_report" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
