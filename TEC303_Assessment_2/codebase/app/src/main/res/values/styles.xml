<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FitnessReport" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/midnight</item>
        <item name="android:navigationBarColor">@color/cloud</item>
        <item name="android:colorAccent">@color/track_blue</item>
        <item name="android:windowBackground">@color/cloud</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="FitnessTextEyebrow">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FitnessTextScreenTitle">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FitnessTextFieldLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FitnessTextCaption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/slate</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="FitnessTextTarget" parent="FitnessTextCaption">
        <item name="android:background">@drawable/target_chip_background</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WorkoutInput">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:gravity">center</item>
        <item name="android:hint">@string/minutes_hint</item>
        <item name="android:inputType">numberSigned</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/slate</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FitnessButtonPrimary">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FitnessButtonSecondary">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">1dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/track_blue</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FitnessButtonTheme">
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/theme_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
